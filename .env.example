# Connexion Supabase du mini-jeu (tirage mensuel).
# La clé publishable n'est pas un secret : elle ne permet que d'enregistrer une
# participation, tout le reste est verrouillé côté base par les règles RLS.
# Ces deux valeurs doivent aussi être définies dans Vercel (Project Settings > Environment Variables).
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
